<Window x:Class="CraftUnifiedBooter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CraftUnifiedBooter.Controls"
        xmlns:pages="clr-namespace:CraftUnifiedBooter.Pages"
        Title="Craft Unified Booter"
        Icon="/Assets/icon.ico"
        Width="1100" Height="700"
        MinWidth="980" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        AllowDrop="True" PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop">

    <Window.Resources>
        <!-- 更新弹窗按钮样式 -->
        <Style x:Key="UpdatePrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateGhostBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlRadius}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <!-- CaptionHeight=0：标题栏交给我们自己处理，保证窗口按钮能用真实鼠标点击
             （CaptionHeight>0 时整条标题栏会被系统当拖拽区，按钮点不动）。
             GlassFrameThickness=1 保留，Win11 的窗口圆角依赖这层系统玻璃边框。
             最大化超屏由 MainWindow 的 WM_GETMINMAXINFO 处理。 -->
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="1" CornerRadius="{DynamicResource Radius0}"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" x:Name="TitleBarRow" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ===================== 背景图片层（用户放入 CUB/backgrounds 的图片，置于所有内容之下） ===================== -->
        <Grid x:Name="BackgroundImageHost" Grid.RowSpan="3" Visibility="Collapsed">
            <Image x:Name="BackgroundImage" Stretch="UniformToFill"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <Border x:Name="BackgroundImageOverlay" Background="#E6FFFFFF" />
        </Grid>

        <!-- ===================== 标题栏 (48px, 白色) ===================== -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="White" ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 拖拽区域 (覆盖整条标题栏；窗口按钮在其上层，不受影响) -->
            <Grid Grid.Column="0" Grid.ColumnSpan="3" Background="Transparent"
                  MouseLeftButtonDown="DragRegion_MouseLeftButtonDown" />

            <!-- 左: 图标 + 名称 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Margin="16,0,0,0"
                        IsHitTestVisible="False">
                <Image Source="/Assets/icon.png" Width="28" Height="28" Stretch="Uniform" />
                <TextBlock Text="CUB2" FontSize="20" FontWeight="Bold"
                           Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"
                           UseLayoutRounding="True" SnapsToDevicePixels="True" />
            </StackPanel>

            <!-- 中: 下载进度胶囊 (无下载时隐藏) -->
            <Border x:Name="DownloadPill" Grid.Column="1" Visibility="Collapsed"
                    CornerRadius="{DynamicResource Radius6}" Background="{DynamicResource AccentBrush}" Padding="14,6" VerticalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PillCount" Text="数量:0" FontSize="13" MinWidth="44"
                                   TextAlignment="Center" FontWeight="Medium" Foreground="White" />
                        <TextBlock Text="|" FontSize="13" Foreground="{DynamicResource AccentLightBrush}" Margin="10,0" />
                        <TextBlock x:Name="PillSpeed" Text="速度:0 KB/s" FontSize="13" MinWidth="82"
                                   TextAlignment="Center" FontWeight="Medium" Foreground="White" />
                        <TextBlock Text="|" FontSize="13" Foreground="{DynamicResource AccentLightBrush}" Margin="10,0" />
                        <TextBlock x:Name="PillRemain" Text="剩余:0" FontSize="13" MinWidth="64"
                                   TextAlignment="Center" FontWeight="Medium" Foreground="White" />
                    </StackPanel>
                    <!-- 横向进度条 -->
                    <Border x:Name="PillTrack" Height="3" Background="#4D60A5FA" CornerRadius="1.5" Margin="0,4,0,0">
                        <Border x:Name="PillFill" Background="White" CornerRadius="1.5" HorizontalAlignment="Left" Width="0" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 右: 更多按钮 + 圆形窗口按钮 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                <Button Style="{StaticResource MoreButtonStyle}" Click="More_Click" ToolTip="下载管理">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="更多" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                        <Path Data="{StaticResource IconChevronDown}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Margin="4,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CircleButtonStyle}" Click="Minimize_Click" ToolTip="最小化">
                    <Path Data="{StaticResource IconMinus}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Button Style="{StaticResource CircleCloseButtonStyle}" Click="Close_Click" ToolTip="关闭启动器">
                    <Path Data="{StaticResource IconClose}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </StackPanel>

            <!-- 底部边框 -->
            <Border Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="1"
                    Background="#E5E7EB" />
        </Grid>

        <!-- ===================== 中部: 侧边栏 + 内容 ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" x:Name="SidebarColumn" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 侧边栏 (150px, 白色) -->
            <Grid x:Name="SidebarRoot" Grid.Column="0" Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="40" x:Name="SidebarVersionRow" />
                </Grid.RowDefinitions>

                <!-- 导航 -->
                <Grid Grid.Row="0" Margin="10,16,10,0" x:Name="NavHost">
                    <!-- 滑动蓝色指示器 (在按钮下层, 避免覆盖文字) -->
                    <Border x:Name="NavIndicator" Width="130" Height="40"
                            CornerRadius="{DynamicResource ControlRadius}"
                            Background="{DynamicResource AccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"
                            IsHitTestVisible="False">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="NavIndicatorTransform" />
                        </Border.RenderTransform>
                    </Border>

                    <StackPanel>
                        <controls:NavButton x:Name="Nav0" Style="{StaticResource NavButtonStyle}" Tag="0" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHome}" Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="主页" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </controls:NavButton>
                        <controls:NavButton x:Name="Nav1" Style="{StaticResource NavButtonStyle}" Tag="1" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconDownload}" Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="下载" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </controls:NavButton>
                        <controls:NavButton x:Name="Nav2" Style="{StaticResource NavButtonStyle}" Tag="2" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconBot}" Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="AI聊天" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </controls:NavButton>
                        <controls:NavButton x:Name="Nav3" Style="{StaticResource NavButtonStyle}" Tag="3" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconServer}" Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="联机" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </controls:NavButton>
                        <controls:NavButton x:Name="Nav4" Style="{StaticResource NavButtonStyle}" Tag="4" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUser}" Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="账户管理" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </controls:NavButton>
                        <controls:NavButton x:Name="Nav5" Style="{StaticResource NavButtonStyle}" Tag="5" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconSettings}" Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="设置" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </controls:NavButton>
                        <controls:NavButton x:Name="Nav6" Style="{StaticResource NavButtonStyle}" Tag="6" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPalette}" Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="个性化" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </controls:NavButton>
                        <controls:NavButton x:Name="Nav7" Style="{StaticResource NavButtonStyle}" Tag="7" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGrid}" Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="小程序" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </controls:NavButton>
                        <controls:NavButton x:Name="Nav8" Style="{StaticResource NavButtonStyle}" Tag="8" Click="Nav_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconInfo}" Width="20" Height="20" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="关于" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </StackPanel>
                        </controls:NavButton>
                    </StackPanel>
                </Grid>

                <!-- 版本 -->
                <Border x:Name="SidebarVersionBar" Grid.Row="1" BorderBrush="#F3F4F6" BorderThickness="0,1,0,0"
                        Background="White" VerticalAlignment="Center" Height="40">
                    <TextBlock Text="v1.1.4" FontSize="12" Foreground="#9CA3AF" Margin="16,0,0,0" VerticalAlignment="Center" />
                </Border>

                <!-- 右边界线 -->
                <Border Grid.RowSpan="2" HorizontalAlignment="Right" Width="1" Background="#E5E7EB" />
            </Grid>

            <!-- 内容区 -->
            <Border x:Name="ContentArea" Grid.Column="1" Background="#F9FAFB">
                <ContentControl x:Name="ContentHost" />
            </Border>

            <!-- 皮肤库覆盖层（盖住侧边栏 + 内容区，左上角自带退出按钮） -->
            <Grid x:Name="SkinLibraryHost" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed"
                  ZIndex="20" Background="#F9FAFB">
                <pages:SkinLibraryPage x:Name="SkinLibrary" />
            </Grid>

            <!-- 版本管理覆盖层（参考 PCL 的版本管理界面） -->
            <Grid x:Name="VersionManagerHost" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed"
                  ZIndex="21" Background="#F9FAFB">
                <pages:VersionManagerPage x:Name="VersionManager" />
            </Grid>

            <!-- 下载管理覆盖层（由标题栏"更多"打开） -->
            <Grid x:Name="DownloadOverlayHost" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed"
                  ZIndex="22" Background="#F9FAFB">
                <pages:DownloadPage x:Name="DownloadOverlay" />
            </Grid>

            <!-- ===================== 更新提示覆盖层（检测到新版本时弹出，强制更新时覆盖全窗口） ===================== -->
            <Grid x:Name="UpdateOverlayHost" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2" Visibility="Collapsed"
                  ZIndex="23" Background="#59000000" FocusManager.IsFocusScope="True">
                <Border Width="460" Background="White" CornerRadius="{DynamicResource CardRadius}" BorderBrush="#E5E7EB" BorderThickness="1"
                        Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Effect="{StaticResource ShadowCard}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="发现新版本" FontSize="18" FontWeight="Bold" Foreground="#111827"
                                       VerticalAlignment="Center" />
                            <Button x:Name="UpdateCloseBtn" HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="30"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                    Click="UpdateLater_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="{DynamicResource Radius15}">
                                            <Path Data="M6 6L18 18 M18 6L6 18" Stroke="#9CA3AF"
                                                  StrokeThickness="2" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Width="14" Height="14" Stretch="Uniform" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <TextBlock x:Name="UpdateVersionText" FontSize="13" Foreground="#374151" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />

                        <Border Background="#F9FAFB" CornerRadius="{DynamicResource Radius10}" Padding="12" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="更新说明" FontSize="12" FontWeight="SemiBold" Foreground="#6B7280" />
                                <TextBlock x:Name="UpdateChangelogText" FontSize="13" Foreground="#374151"
                                          Margin="0,6,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="UpdateSizeText" FontSize="12" Foreground="#9CA3AF" Margin="0,12,0,0" />

                        <!-- 下载进度（开始更新后显示） -->
                        <ProgressBar x:Name="UpdateProgressBar" Height="6" Margin="0,16,0,0"
                                     Minimum="0" Maximum="100" Visibility="Collapsed"
                                     Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock x:Name="UpdateProgressText" FontSize="12" Foreground="#6B7280" Margin="0,7,0,0"
                                   Visibility="Collapsed" TextAlignment="Center" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <Button x:Name="UpdateLaterBtn" Content="稍后再说" Style="{StaticResource UpdateGhostBtnStyle}"
                                    Click="UpdateLater_Click" Margin="0,0,10,0" />
                            <Button x:Name="UpdateDownloadBtn" Content="立即更新" Style="{StaticResource UpdatePrimaryBtnStyle}"
                                    Click="UpdateDownload_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ===================== 底部状态栏 (28px, 白色) ===================== -->
        <Border x:Name="StatusBar" Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="16,0">
            <Grid>
                <TextBlock x:Name="FooterLeft" Text="当前版本: 未选择" FontSize="12" Foreground="#9CA3AF"
                           VerticalAlignment="Center" HorizontalAlignment="Left" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#D1D5DB" VerticalAlignment="Center" />
                    <TextBlock x:Name="FooterStatus" Text="未启动" FontSize="12" Foreground="#9CA3AF"
                               VerticalAlignment="Center" Margin="6,0,16,0" />
                    <TextBlock Text="Powered by" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" />
                    <TextBlock Text="CUB" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                                <GradientStop Color="#0EA5E9" Offset="0.5" />
                                <GradientStop Color="#06B6D4" Offset="1" />
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock x:Name="FooterVersion" Text="v1.1.4" FontSize="12" Foreground="#9CA3AF" Margin="4,0,0,0"
                               VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="FooterVersion_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 右上角 Toast 通知（替代 MessageBox，约 1 秒自动消失） ===================== -->
        <StackPanel x:Name="ToastHost" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,56,16,0" />

        <!-- ===================== 窗口边缘彩色滚动光效（重复双击启动器时显示一圈连续渐变彩虹） ===================== -->
        <Border x:Name="RainbowFrame" Grid.RowSpan="3" Panel.ZIndex="10000"
                IsHitTestVisible="False" BorderThickness="8" Visibility="Collapsed" />
    </Grid>
</Window>
