<UserControl x:Class="CraftUnifiedBooter.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackground}" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="{DynamicResource Radius12}" Background="{DynamicResource AccentSoftBrush}">
                    <Path Data="M2 12A10 10 0 1 1 22 12A10 10 0 1 1 2 12Z M11.5 7.5H12.5 M12 12V16"
                          Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock Text="CUB 启动器信息" FontSize="12" Foreground="#9CA3AF" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 三模块布局：左上角 / 右上角 / 下方（内容留白，待后续填充） -->
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="220" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 左上角模块（留白） -->
            <Border Grid.Row="0" Grid.Column="0"
                    Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius12}">
                <TextBlock Text="内容待添加" FontSize="12" Foreground="#D1D5DB"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- 右上角模块（留白） -->
            <Border Grid.Row="0" Grid.Column="2"
                    Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius12}">
                <TextBlock Text="内容待添加" FontSize="12" Foreground="#D1D5DB"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- 下方模块（留白，跨两列） -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                    Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius12}">
                <TextBlock Text="内容待添加" FontSize="12" Foreground="#D1D5DB"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</UserControl>