<UserControl x:Class="CraftUnifiedBooter.Pages.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- ============ 内联 lucide 描边图标 (24x24 视口) ============ -->
        <Geometry x:Key="IconArrowLeft">M19 12H5 M12 19L5 12L12 5</Geometry>
        <Geometry x:Key="IconTrash2">M3 6H21 M19 6V20A2 2 0 0 1 17 22H7A2 2 0 0 1 5 20V6 M8 6V4A2 2 0 0 1 10 2H14A2 2 0 0 1 16 4V6 M10 11V17 M14 11V17</Geometry>
        <Geometry x:Key="IconLoader">M21 12A9 9 0 1 1 12 3</Geometry>
        <Geometry x:Key="IconCheckCircle2">M21.8 10A10 10 0 1 1 17 3.3 M9 11L12 14L22 4</Geometry>
        <Geometry x:Key="IconXCircle">M2 12A10 10 0 1 1 22 12A10 10 0 1 1 2 12Z M15 9L9 15 M9 9L15 15</Geometry>
        <Geometry x:Key="IconShieldCheck">M20 13C20 18 16.5 20.8 12 22C7.5 20.8 4 18 4 13V6L12 2L20 6V13Z M9 12L11 14L15 10</Geometry>
        <Geometry x:Key="IconPackage">M16.5 9.4L7.55 4.24 M21 16V8A2 2 0 0 0 20 6.2L13 2.2A2 2 0 0 0 11 2.2L4 6.2A2 2 0 0 0 3 8V16A2 2 0 0 0 4 17.8L11 21.8A2 2 0 0 0 13 21.8L20 17.8A2 2 0 0 0 21 16Z M7.5 10.5L12 13L16.5 10.5 M12 13V21</Geometry>
        <Geometry x:Key="IconEye">M2 12S6.5 5 12 5S22 12 22 12S17.5 19 12 19S2 12 2 12Z M12 9.5A2.5 2.5 0 1 1 12 14.5A2.5 2.5 0 1 1 12 9.5Z</Geometry>
        <Geometry x:Key="IconDownload">M21 15V18A2 2 0 0 1 19 20H5A2 2 0 0 1 3 18V15 M7 10L12 15L17 10 M12 15V3</Geometry>

        <!-- ============ 返回按钮 (圆角 8, 浅灰 hover) ============ -->
        <Style x:Key="BackButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius12}"
                                Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                <Setter Property="Foreground" Value="#374151" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ 清空历史按钮 (灰色文字, hover 浅灰底) ============ -->
        <Style x:Key="GhostButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius12}"
                                Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                <Setter Property="Foreground" Value="#4B5563" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    <!-- ============ 筛选按钮样式 ============ -->
        <Style x:Key="FilterChipStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius8}" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterChipUnselectedStyle" TargetType="Button" BasedOn="{StaticResource FilterChipStyle}">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius8}" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackground}">
        <ScrollViewer VerticalScrollBarVisibility="Hidden" Padding="24,24,24,32">
            <StackPanel>

                <!-- ============ 顶部标题栏 ============ -->
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource BackButtonStyle}" VerticalAlignment="Center" ToolTip="返回" Click="Back_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconArrowLeft}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="返回" FontSize="14" Margin="6,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="下载管理" FontSize="20" FontWeight="Bold" Foreground="#111827"
                               VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Border x:Name="ActiveBadge" Background="{DynamicResource AccentSoftBrush}" CornerRadius="{DynamicResource Radius4}" Padding="10,2"
                            Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="ActiveBadgeText" Text="0 个进行中" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <!-- ============ 汇总卡片 (蓝色渐变) ============ -->
                <Border CornerRadius="{DynamicResource Radius16}" Padding="24" Margin="0,24,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                            <GradientStop Color="{DynamicResource AccentDarkColor}" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="总下载速度" FontSize="14" Foreground="{DynamicResource AccentSoftBrush}" />
                                <TextBlock x:Name="SpeedLabel" Text="0 MB/s" FontSize="28" FontWeight="Bold" Foreground="White"
                                           FontFamily="Consolas" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="总进度" FontSize="14" Foreground="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Right" />
                                <TextBlock x:Name="PercentLabel" Text="0%" FontSize="28" FontWeight="Bold" Foreground="White"
                                           FontFamily="Consolas" HorizontalAlignment="Right" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- 总进度条 -->
                        <Border x:Name="ProgressTrack" Height="8" Background="#4D60A5FA" CornerRadius="{DynamicResource Radius4}" Margin="0,16,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ProgressFill" Grid.Column="0" Grid.ColumnSpan="2" Background="White" CornerRadius="{DynamicResource Radius4}"
                                        HorizontalAlignment="Left" Width="0" />
                            </Grid>
                        </Border>

                        <Grid Margin="0,8,0,0">
                            <TextBlock x:Name="TotalSizeLabel" Text="0 B / 0 B" FontSize="12" Foreground="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RemainingLabel" Text="剩余文件: 0" FontSize="12" Foreground="{DynamicResource AccentSoftBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ 筛选与排序栏 ============ -->
                <Border Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="{DynamicResource Radius12}"
                        Padding="14,10" Margin="0,20,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="筛选" FontSize="13" FontWeight="Medium" Foreground="#6B7280"
                                   VerticalAlignment="Center" Margin="4,0,8,0" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FilterAll" Style="{StaticResource FilterChipStyle}" Content="全部"
                                    Tag="all" Click="FilterStatus_Click" />
                            <Button x:Name="FilterActive" Style="{StaticResource FilterChipUnselectedStyle}" Content="进行中"
                                    Tag="active" Click="FilterStatus_Click" />
                            <Button x:Name="FilterPaused" Style="{StaticResource FilterChipUnselectedStyle}" Content="暂停"
                                    Tag="paused" Click="FilterStatus_Click" />
                            <Button x:Name="FilterDone" Style="{StaticResource FilterChipUnselectedStyle}" Content="已完成"
                                    Tag="done" Click="FilterStatus_Click" />
                            <Button x:Name="FilterCanceled" Style="{StaticResource FilterChipUnselectedStyle}" Content="已取消"
                                    Tag="canceled" Click="FilterStatus_Click" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="排序" FontSize="13" FontWeight="Medium" Foreground="#6B7280"
                                       VerticalAlignment="Center" Margin="4,0,8,0" />
                            <ComboBox x:Name="SortCombo" Width="140" Height="30" FontSize="13"
                                      SelectionChanged="SortCombo_SelectionChanged">
                                <ComboBoxItem Content="按时间（新→旧）" IsSelected="True" />
                                <ComboBoxItem Content="按优先级（高→低）" />
                                <ComboBoxItem Content="按进度（高→低）" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ 动态任务列表 ============ -->
                <StackPanel x:Name="TaskItemsPanel" Margin="0,12,0,0" />

                <!-- ============ 历史任务分隔行 ============ -->
                <Grid x:Name="HistoryHeaderRow" Margin="0,20,0,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="历史任务" FontSize="14" FontWeight="SemiBold" Foreground="#374151"
                                   VerticalAlignment="Center" />
                        <Border x:Name="HistoryOkBadge" Background="#DCFCE7" CornerRadius="{DynamicResource Radius4}" Padding="8,2" Margin="8,0,0,0">
                            <TextBlock x:Name="HistoryOkText" Text="0 已完成" FontSize="12" FontWeight="Medium" Foreground="#16A34A" />
                        </Border>
                        <Border x:Name="HistoryFailBadge" Background="#FEE2E2" CornerRadius="{DynamicResource Radius4}" Padding="8,2" Margin="6,0,0,0">
                            <TextBlock x:Name="HistoryFailText" Text="0 失败" FontSize="12" FontWeight="Medium" Foreground="#EF4444" />
                        </Border>
                    </StackPanel>
                    <Button Style="{StaticResource GhostButtonStyle}" Click="ClearHistory_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTrash2}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <TextBlock Text="清空历史" FontSize="12" Margin="4,0,0,0" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ============ 历史任务列表 ============ -->
                <StackPanel x:Name="HistoryItemsPanel" Visibility="Collapsed" />

                <!-- ============ 空状态 ============ -->
                <Border x:Name="EmptyState" Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
                        CornerRadius="{DynamicResource Radius12}" Padding="32" Margin="0,24,0,0" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconDownload}" Width="40" Height="40" Stretch="Uniform"
                              Stroke="#D1D5DB" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              HorizontalAlignment="Center" />
                        <TextBlock Text="暂无下载任务" FontSize="14" FontWeight="Medium"
                                   Foreground="#9CA3AF" Margin="0,12,0,4"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="从「下载」页选择版本或资源安装，下载进度将在此显示"
                                   FontSize="12" Foreground="#D1D5DB" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
