<UserControl x:Class="CraftUnifiedBooter.Pages.AccountPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- ===== lucide 描边图标 (24x24 视口) ===== -->
        <Geometry x:Key="IconUserPlus">M11.5 4A4 4 0 1 0 11.5 12A4 4 0 1 0 11.5 4 M4 20A7.5 7.5 0 0 1 19 20 M18.5 6.5V12.5 M15.5 9.5H21.5</Geometry>
        <Geometry x:Key="IconCheck">M20 6L9 17L4 12</Geometry>
        <Geometry x:Key="IconTrash2">M3 6H21 M19 6V20A2 2 0 0 1 17 22H7A2 2 0 0 1 5 20V6 M8 6V4A2 2 0 0 1 10 2H14A2 2 0 0 1 16 4V6 M10 11V17 M14 11V17</Geometry>

        <!-- ===== 阴影 ===== -->
        <DropShadowEffect x:Key="ShadowCard" Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.25" />

        <!-- ===== 按钮样式 ===== -->
        <!-- 蓝色实心按钮 (小尺寸 32-40px 用圆角 6) -->
        <Style x:Key="BlueSolidButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius6}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 灰色小按钮 (选择 / 取消 / 添加离线账户) 圆角 6 -->
        <Style x:Key="GraySmallButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius6}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 删除图标按钮 圆角 6 -->
        <Style x:Key="TrashIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius6}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEF2F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 微软登录 (蓝色) 圆角 6 -->
        <Style x:Key="MicrosoftButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius6}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 弹窗输入框 (灰底灰边框, 圆角 8, placeholder 由 Tag 提供) ===== -->
        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="{DynamicResource Radius8}">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" FontSize="14"
                                           Foreground="#9CA3AF" VerticalAlignment="Center" Margin="12,0"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="12,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                                <Setter TargetName="Bd" Property="Background" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackground}">
        <!-- 内容 (max-width 768 居中, padding 24) -->
        <Grid Margin="24">
            <StackPanel>
                <!-- 标题 + 操作按钮 -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="账户管理" FontSize="20" FontWeight="Bold" Foreground="#111827"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource GraySmallButtonStyle}" Height="36" Padding="16,0"
                                Click="OpenAddDialog">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconUserPlus}" Width="16" Height="16" Stretch="Uniform"
                                      VerticalAlignment="Center"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                <TextBlock Text="离线账户" FontSize="14" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource MicrosoftButtonStyle}" Height="36" Padding="16,0"
                                Margin="8,0,0,0" Click="MicrosoftLogin_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M1 1H10V10H1Z M11 1H20V10H11Z M1 11H10V20H1Z M11 11H20V20H11Z"
                                      Fill="White" Width="16" Height="16" Stretch="Uniform"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="微软登录" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 账户列表（动态渲染） -->
                <StackPanel x:Name="AccountsListPanel" Margin="0,16,0,0" />
            </StackPanel>
        </Grid>

        <!-- ===================== 微软登录弹窗（设备码流程） ===================== -->
        <Grid x:Name="MsOverlay" Visibility="Collapsed">
            <Border Background="#80000000" />
            <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource Radius12}" Padding="24" Effect="{StaticResource ShadowCard}">
                <StackPanel>
                    <TextBlock Text="微软登录" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBlock x:Name="MsStatusText" FontSize="13" Foreground="#6B7280" TextWrapping="Wrap"
                               Margin="0,8,0,0" Text="正在向微软申请设备码…" />

                    <Border x:Name="MsCodeBox" Visibility="Collapsed" Background="#F3F4F6"
                            CornerRadius="{DynamicResource Radius8}" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="在浏览器中输入以下代码" FontSize="12" Foreground="#6B7280"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="MsCodeText" FontSize="30" FontWeight="Bold" Foreground="#111827"
                                       FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="MsLinkText" FontSize="12" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"
                               Margin="0,10,0,0" Visibility="Collapsed" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="MsOpenBtn" Style="{StaticResource GraySmallButtonStyle}" Height="36"
                                Padding="14,0" Content="打开登录页面" Visibility="Collapsed" Click="MsOpenBrowser_Click" />
                        <Button x:Name="MsCopyBtn" Style="{StaticResource GraySmallButtonStyle}" Height="36"
                                Padding="14,0" Margin="8,0,0,0" Content="复制代码" Visibility="Collapsed"
                                Click="MsCopyCode_Click" />
                        <Button Style="{StaticResource GraySmallButtonStyle}" Height="36" Padding="16,0"
                                Margin="8,0,0,0" Content="取消" Click="MsCancel_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== 添加离线账户弹窗 ===================== -->
        <Grid x:Name="AddOverlay" Visibility="Collapsed">
            <Border Background="#80000000" />
            <Border Width="384" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource CardBackground}" CornerRadius="{DynamicResource Radius12}" Padding="24" Effect="{StaticResource ShadowCard}">
                <StackPanel>
                    <TextBlock Text="添加离线账户" FontSize="18" FontWeight="SemiBold" Foreground="#111827" />
                    <TextBox x:Name="NewNameBox" Style="{StaticResource DialogTextBoxStyle}"
                             Tag="输入用户名..." Margin="0,16,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource GraySmallButtonStyle}" Height="36" Padding="16,0"
                                Click="CloseAddDialog">取消</Button>
                        <Button Style="{StaticResource BlueSolidButtonStyle}" Height="36" Padding="16,0"
                                Margin="8,0,0,0" Click="ConfirmAdd">确定</Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
