<UserControl x:Class="CraftUnifiedBooter.Pages.AIChatPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- ============ 内联 lucide 描边图标 (24x24 视口) ============ -->
        <Geometry x:Key="IconSend">M22 2L11 13 M22 2L15 22L11 13L2 9L22 2Z</Geometry>
        <Geometry x:Key="IconLock">M5 11H19A2 2 0 0 1 21 13V20A2 2 0 0 1 19 22H5A2 2 0 0 1 3 20V13A2 2 0 0 1 5 11Z M7 11V7A5 5 0 0 1 17 7V11</Geometry>
    </UserControl.Resources>

    <!-- 整页白底卡片, 铺满 (Margin=0) -->
    <Border Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="{DynamicResource Radius12}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ 顶栏 ============ -->
            <Border Grid.Row="0" BorderBrush="#F3F4F6" BorderThickness="0,0,0,1"
                    Padding="20,16" Background="{DynamicResource CardBackground}">
                <StackPanel Orientation="Horizontal">
                    <Border Width="40" Height="40" CornerRadius="{DynamicResource Radius12}" Background="{DynamicResource AccentSoftBrush}">
                        <Path Data="{StaticResource IconBot}" Width="20" Height="20" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AI 聊天" FontSize="14" FontWeight="SemiBold" Foreground="#111827" />
                        <TextBlock Text="智能助手" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 消息区 ============ -->
            <ScrollViewer Grid.Row="1" Background="{DynamicResource PageBackground}" VerticalScrollBarVisibility="Hidden"
                          Padding="20,16">
                <StackPanel>
                    <!-- 欢迎消息气泡 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Border Width="28" Height="28" CornerRadius="{DynamicResource Radius8}" Background="{DynamicResource AccentSoftBrush}"
                                VerticalAlignment="Bottom">
                            <Path Data="{StaticResource IconBot}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Border>
                        <Border Margin="8,0,0,0" MaxWidth="540" Background="{DynamicResource CardBackground}"
                                BorderBrush="#E5E7EB" BorderThickness="1"
                                CornerRadius="16,16,16,4" Padding="16,10">
                            <TextBlock Text="你好，我是 CUB 智能助手，可以帮你解答启动器使用问题。"
                                       FontSize="14" Foreground="#374151" TextWrapping="Wrap" LineHeight="22" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 输入区 (禁用态) ============ -->
            <Border Grid.Row="2" Background="{DynamicResource CardBackground}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Height="1" Background="#F3F4F6" VerticalAlignment="Top" Grid.ColumnSpan="2" />

                <Border Height="40" Background="#F3F4F6" CornerRadius="{DynamicResource Radius12}"
                        BorderBrush="#E5E7EB" BorderThickness="1">
                    <TextBlock Text="输入消息，回车发送" FontSize="14" Foreground="#9CA3AF"
                               VerticalAlignment="Center" Margin="16,0" />
                </Border>

                <Button Grid.Column="1" Width="96" Height="40" Margin="12,0,0,0"
                        Background="{DynamicResource AccentBrush}" Opacity="0.4" IsEnabled="False" Cursor="Arrow">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius12}">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSend}" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                                    <TextBlock Text="发送" FontSize="14" FontWeight="Medium" Foreground="White"
                                               Margin="6,0,0,0" />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                </Grid>
            </Border>

            <!-- ============ 锁定遮罩 (铺满整个页面) ============ -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#CCF3F4F6" Panel.ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Ellipse Width="12" Height="12" Fill="#EF4444" VerticalAlignment="Center" />
                        <Border Width="64" Height="64" CornerRadius="{DynamicResource Radius16}" Background="#FEF2F2"
                                BorderBrush="#FECACA" BorderThickness="1" Margin="16,0">
                            <Path Data="{StaticResource IconLock}" Width="32" Height="32" Stretch="Uniform"
                                  Stroke="#EF4444" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </Border>
                        <Ellipse Width="12" Height="12" Fill="#EF4444" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="功能还未开放" FontSize="14" FontWeight="SemiBold" Foreground="#374151"
                               HorizontalAlignment="Center" Margin="0,16,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
