<UserControl x:Class="CraftUnifiedBooter.Pages.VersionManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- ===== lucide 描边图标 ===== -->
        <Geometry x:Key="IconBack">M19 12H5 M12 19L5 12L12 5</Geometry>
        <Geometry x:Key="IconLayers">M12 2L2 7L12 12L22 7Z M2 12L12 17L22 12 M2 17L12 22L22 17</Geometry>
        <Geometry x:Key="IconRefresh">M21 12A9 9 0 1 1 18.4 5.6 M21 3V9H15</Geometry>
        <Geometry x:Key="IconTrash">M3 6H21 M19 6V20A2 2 0 0 1 17 22H7A2 2 0 0 1 5 20V6 M8 6V4A2 2 0 0 1 10 2H14A2 2 0 0 1 16 4V6 M10 11V17 M14 11V17</Geometry>
        <Geometry x:Key="IconFolder">M3 7A2 2 0 0 1 5 5H9L11 8H19A2 2 0 0 1 21 10V18A2 2 0 0 1 19 20H5A2 2 0 0 1 3 18Z</Geometry>
        <Geometry x:Key="IconPlus">M12 6.5V17.5 M6.5 12H17.5</Geometry>
        <Geometry x:Key="IconExport">M12 3V15 M7 10L12 15L17 10 M21 15V18A2 2 0 0 1 19 20H5A2 2 0 0 1 3 18V15</Geometry>
        <Geometry x:Key="IconCube">M12 2L21 7V17L12 22L3 17V7Z M12 12L21 7 M12 12V22 M12 12L3 7</Geometry>
        <Geometry x:Key="IconGlobe">M12 21A9 9 0 1 0 12 3A9 9 0 1 0 12 21Z M3 12H21 M12 3A14 14 0 0 1 12 21A14 14 0 0 1 12 3Z</Geometry>
        <Geometry x:Key="IconHome">M3 11L12 3L21 11 M5 10V20H10V14H14V20H19V10</Geometry>

        <!-- ===== 卡片 ===== -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <!-- ===== 灰色小按钮 ===== -->
        <Style x:Key="GrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius7}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 蓝色实心按钮 ===== -->
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius7}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 图标按钮 ===== -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius6}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEF2F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 右侧操作按钮（大按钮） ===== -->
        <Style x:Key="FolderActionStyle" TargetType="Button">
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="{DynamicResource Radius10}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D1D5DB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== 顶部：退出 + 标题 + 当前版本 ===================== -->
        <Grid Grid.Row="0" Margin="20,0,20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Exit_Click" Cursor="Hand" ToolTip="返回主页">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius10}" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBack}" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="#374151" StrokeThickness="2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                    <TextBlock Text="退出" FontSize="13" FontWeight="Medium" Foreground="#374151"
                                               Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Path Data="{StaticResource IconLayers}" Width="20" Height="20" Stretch="Uniform"
                      Stroke="#7C3AED" StrokeThickness="2" StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Margin="16,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="版本管理" FontSize="18" FontWeight="Bold" Foreground="#111827"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
                <Border Background="#EEF2FF" CornerRadius="{DynamicResource Radius6}" Padding="9,3" Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentVersionPill" Text="未选择版本" FontSize="11" Foreground="#4F46E5" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===================== 主体：版本列表 | Mod 管理 | 右侧操作区 ===================== -->
        <Grid Grid.Row="1" Margin="20,0,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="250" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：已安装版本 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="已安装版本" FontSize="14" FontWeight="SemiBold" Foreground="#374151"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource GrayButtonStyle}" Height="30" Padding="10,0"
                                Click="RefreshVersions_Click" ToolTip="重新扫描已安装版本">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="刷新" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,12,0,0">
                        <StackPanel x:Name="VersionListPanel" />
                    </ScrollViewer>

                    <Button Grid.Row="2" Style="{StaticResource GrayButtonStyle}" Height="34" Margin="0,12,0,0"
                            Click="OpenVersionsFolder_Click" Content="打开版本文件夹" />
                </Grid>
            </Border>

            <!-- ===== 中：Mod 管理 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ModPathText" Text="Mod 目录" FontSize="11" Foreground="#9CA3AF"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="AddModBtn" Style="{StaticResource GrayButtonStyle}" Height="30" Padding="10,0"
                                    Click="AddMod_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconPlus}" Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" VerticalAlignment="Center" />
                                    <TextBlock Text="添加 Mod" FontSize="12" Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenModsFolderBtn" Style="{StaticResource GrayButtonStyle}" Height="30" Padding="10,0"
                                    Margin="8,0,0,0" Click="OpenModsFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconFolder}" Width="14" Height="14"
                                          Stretch="Uniform"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          VerticalAlignment="Center" />
                                    <TextBlock Text="打开文件夹" FontSize="12" Margin="5,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,10,0,0">
                        <StackPanel x:Name="ModListPanel" />
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" x:Name="ModHintText" FontSize="11" Foreground="#9CA3AF"
                               TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="Mod 文件放在对应版本目录下的 mods 文件夹中。" />
                </Grid>
            </Border>

            <!-- ===== 右：版本信息 / 快捷方式 / 导出 ===== -->
            <StackPanel Grid.Column="4">
                <!-- 版本信息 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="当前版本" FontSize="12" FontWeight="SemiBold" Foreground="#9CA3AF" />
                        <TextBlock x:Name="DetailVersionText" Text="未选择版本" FontSize="16" FontWeight="Bold"
                                   Foreground="#111827" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                        <Border x:Name="DetailLoaderPill" Background="#F3F4F6" CornerRadius="{DynamicResource Radius6}"
                                Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left">
                            <TextBlock x:Name="DetailLoaderText" Text="原版" FontSize="11" Foreground="#6B7280" />
                        </Border>
                        <TextBlock x:Name="DetailPathText" FontSize="10" Foreground="#9CA3AF"
                                   Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- 快捷方式 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="快捷方式" FontSize="13" FontWeight="SemiBold" Foreground="#374151"
                                   Margin="2,0,0,10" />
                        <Button Style="{StaticResource FolderActionStyle}" Click="OpenVersionFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconHome}" Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock Text="打开主文件夹" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FolderActionStyle}" Click="OpenModsFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconCube}" Width="16" Height="16" Stretch="Uniform"
                                      Stroke="#0EA5E9" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock Text="打开模组文件夹" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FolderActionStyle}" Click="OpenSavesFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconGlobe}" Width="16" Height="16" Stretch="Uniform"
                                      Stroke="#7C3AED" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock Text="打开世界文件夹" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FolderActionStyle}" Click="VerifyFiles_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconRefresh}" Width="16" Height="16" Stretch="Uniform"
                                      Stroke="#16A34A" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock Text="校验文件完整性" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- 导出 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0">
                    <StackPanel>
                        <TextBlock Text="导出" FontSize="13" FontWeight="SemiBold" Foreground="#374151"
                                   Margin="2,0,0,10" />
                        <Button Style="{StaticResource BlueButtonStyle}" Height="42" Click="ExportVersion_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconExport}" Width="16" Height="16" Stretch="Uniform"
                                      Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock Text="导出版本" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock FontSize="10" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="将版本目录（版本 JSON、jar、Mods、配置、存档）打包为 .zip，便于备份或分享。" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>