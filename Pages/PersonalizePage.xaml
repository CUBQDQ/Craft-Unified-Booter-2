<UserControl x:Class="CraftUnifiedBooter.Pages.PersonalizePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- ==================== lucide 描边图标 (24x24 视口) ==================== -->
        <Geometry x:Key="IconPalette">M3 12A9 9 0 1 1 21 12A9 9 0 1 1 3 12Z M7.5 9.5A1 1 0 1 1 9.5 9.5A1 1 0 1 1 7.5 9.5Z M12.5 7.3A1 1 0 1 1 14.5 7.3A1 1 0 1 1 12.5 7.3Z M15.6 12.4A1 1 0 1 1 17.6 12.4A1 1 0 1 1 15.6 12.4Z M8.8 16.4A1 1 0 1 1 10.8 16.4A1 1 0 1 1 8.8 16.4Z</Geometry>
        <Geometry x:Key="IconLayout">M5 3H19A2 2 0 0 1 21 5V19A2 2 0 0 1 19 21H5A2 2 0 0 1 3 19V5A2 2 0 0 1 5 3Z M3 9H21 M9 21V9</Geometry>
        <Geometry x:Key="IconInfo">M2 12A10 10 0 1 1 22 12A10 10 0 1 1 2 12Z M11.5 7.5H12.5 M12 12V16</Geometry>
        <Geometry x:Key="IconDownload">M21 15V18A2 2 0 0 1 19 20H5A2 2 0 0 1 3 18V15 M7 10L12 15L17 10 M12 15V3</Geometry>
        <Geometry x:Key="IconMove">M5 9L2 12L5 15 M9 5L12 2L15 5 M15 19L12 22L9 19 M19 9L22 12L19 15 M2 12H22 M12 2V22</Geometry>
        <Geometry x:Key="IconRotateCcw">M3 12A9 9 0 1 0 12 3A9.75 9.75 0 0 0 5.26 5.74L3 8 M3 3V8H8</Geometry>
        <Geometry x:Key="IconFolder">M3 7A2 2 0 0 1 5 5H9L11 7H19A2 2 0 0 1 21 9V17A2 2 0 0 1 19 19H5A2 2 0 0 1 3 17Z</Geometry>

        <!-- ==================== 按钮样式 ==================== -->
        <Style x:Key="GrayBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius12}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                  Background="{DynamicResource PageBackground}">
        <StackPanel Margin="24,24,24,24">

            <TextBlock Text="个性化" FontSize="20" FontWeight="Bold" Foreground="#111827" />

            <!-- ==================== 1. 主题外观 ==================== -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius12}" Padding="20" Margin="0,20,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Data="{StaticResource IconPalette}" Width="20" Height="20" Stretch="Uniform"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Text="主题外观" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#111827" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 界面主题 -->
                    <Border BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="界面主题" FontSize="13" Foreground="#374151" />
                                <TextBlock Text="CUB：纯白简洁；通透质感：轻量毛玻璃"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="{DynamicResource Radius8}" Padding="2"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="ThemeCub" Tag="theme:cub" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="White"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="Black" />
                                        </Border.Effect>
                                        <TextBlock Text="CUB 主题" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="ThemeGlass" Tag="theme:glass" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="Transparent"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <TextBlock Text="通透质感" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 个性化颜色 -->
                    <Border BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="个性化颜色" FontSize="13" Foreground="#374151" />
                                <TextBlock Text="界面主色（单一纯色），用于按钮、高亮、选中项等"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="AccentBlue" Tag="blue" Width="32" Height="32" BorderThickness="2" Padding="2" CornerRadius="{DynamicResource Radius14}"
                                        BorderBrush="{DynamicResource AccentBrush}" Background="Transparent" Cursor="Hand"
                                        MouseLeftButtonDown="AccentDot_Click">
                                    <Ellipse Fill="#3B82F6" />
                                </Border>
                                <Border x:Name="AccentViolet" Tag="violet" Width="32" Height="32" BorderThickness="2" Padding="2" CornerRadius="{DynamicResource Radius14}"
                                        BorderBrush="Transparent" Background="Transparent" Cursor="Hand"
                                        Margin="4,0,0,0" MouseLeftButtonDown="AccentDot_Click">
                                    <Ellipse Fill="#8B5CF6" />
                                </Border>
                                <Border x:Name="AccentGreen" Tag="green" Width="32" Height="32" BorderThickness="2" Padding="2" CornerRadius="{DynamicResource Radius14}"
                                        BorderBrush="Transparent" Background="Transparent" Cursor="Hand"
                                        Margin="4,0,0,0" MouseLeftButtonDown="AccentDot_Click">
                                    <Ellipse Fill="#22C55E" />
                                </Border>
                                <Border x:Name="AccentOrange" Tag="orange" Width="32" Height="32" BorderThickness="2" Padding="2" CornerRadius="{DynamicResource Radius14}"
                                        BorderBrush="Transparent" Background="Transparent" Cursor="Hand"
                                        Margin="4,0,0,0" MouseLeftButtonDown="AccentDot_Click">
                                    <Ellipse Fill="#F97316" />
                                </Border>
                                <Border x:Name="AccentPink" Tag="pink" Width="32" Height="32" BorderThickness="2" Padding="2" CornerRadius="{DynamicResource Radius14}"
                                        BorderBrush="Transparent" Background="Transparent" Cursor="Hand"
                                        Margin="4,0,0,0" MouseLeftButtonDown="AccentDot_Click">
                                    <Ellipse Fill="#EC4899" />
                                </Border>
                                <Border x:Name="AccentCyan" Tag="cyan" Width="32" Height="32" BorderThickness="2" Padding="2" CornerRadius="{DynamicResource Radius14}"
                                        BorderBrush="Transparent" Background="Transparent" Cursor="Hand"
                                        Margin="4,0,0,0" MouseLeftButtonDown="AccentDot_Click">
                                    <Ellipse Fill="#06B6D4" />
                                </Border>
                                <Border x:Name="AccentRed" Tag="red" Width="32" Height="32" BorderThickness="2" Padding="2" CornerRadius="{DynamicResource Radius14}"
                                        BorderBrush="Transparent" Background="Transparent" Cursor="Hand"
                                        Margin="4,0,0,0" MouseLeftButtonDown="AccentDot_Click">
                                    <Ellipse Fill="#EF4444" />
                                </Border>
                                <Border x:Name="AccentAmber" Tag="amber" Width="32" Height="32" BorderThickness="2" Padding="2" CornerRadius="{DynamicResource Radius14}"
                                        BorderBrush="Transparent" Background="Transparent" Cursor="Hand"
                                        Margin="4,0,0,0" MouseLeftButtonDown="AccentDot_Click">
                                    <Ellipse Fill="#F59E0B" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 圆角风格 -->
                    <Border BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="圆角风格" FontSize="13" Foreground="#374151" />
                                <TextBlock Text="按钮、卡片、弹窗的圆角大小"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="{DynamicResource Radius8}" Padding="2"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="RadiusNone" Tag="radius:none" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="Transparent"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <TextBlock Text="直角" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="RadiusDefault" Tag="radius:default" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="White"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="Black" />
                                        </Border.Effect>
                                        <TextBlock Text="标准" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="RadiusLarge" Tag="radius:large" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="Transparent"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <TextBlock Text="大圆角" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 界面字体大小 -->
                    <Border Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="界面字体大小" FontSize="13" Foreground="#374151" />
                                <TextBlock Text="全局文字缩放"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="{DynamicResource Radius8}" Padding="2"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="FontSmall" Tag="font:small" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="Transparent"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <TextBlock Text="小" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="FontMedium" Tag="font:medium" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="White"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="Black" />
                                        </Border.Effect>
                                        <TextBlock Text="标准" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="FontLarge" Tag="font:large" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="Transparent"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <TextBlock Text="大" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 图片背景（仅开发者模式可见） -->
                    <Border x:Name="BackgroundImageSection" BorderBrush="#EFF6FF" BorderThickness="0,0,0,1" Padding="0,14">
                        <StackPanel>
                            <!-- 开发者内容提示 -->
                            <Border x:Name="DeveloperBadge" Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius8}" Padding="10,8" Margin="0,0,0,14"
                                    HorizontalAlignment="Left" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="18" Height="18" CornerRadius="{DynamicResource Radius6}"
                                            Background="#F59E0B" VerticalAlignment="Center">
                                        <TextBlock Text="!" FontSize="12" FontWeight="Bold" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="这是开发者内容，请仔细分辨" FontSize="12" FontWeight="SemiBold"
                                               Foreground="#92400E" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                    <TextBlock Text="图片背景" FontSize="13" Foreground="#374151" />
                                    <TextBlock Text="把 jpg/png 图片放进 CUB/backgrounds 文件夹即可作为窗口背景（推荐 1920×1080）"
                                               FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="ToggleBackgroundImage" Width="42" Height="24"
                                            CornerRadius="{DynamicResource RadiusPill}" Background="#D1D5DB" Cursor="Hand"
                                            MouseLeftButtonDown="ToggleBackgroundImage_Click" VerticalAlignment="Center">
                                        <Ellipse Width="18" Height="18" Fill="White"
                                                 HorizontalAlignment="Left" Margin="3,0,0,0">
                                            <Ellipse.RenderTransform>
                                                <TranslateTransform x:Name="TransBackgroundImage" X="0" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Border>
                                    <Button Style="{StaticResource GrayBtnStyle}" Height="32" Padding="12,0"
                                            Margin="10,0,0,0" Click="OpenBackgroundFolder_Click" ToolTip="打开 CUB/backgrounds 文件夹">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconFolder}" Width="14" Height="14" Stretch="Uniform"
                                                  Stroke="#374151" StrokeThickness="2" StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                            <TextBlock Text="打开图片文件夹" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 多图切换：手动 / 自动轮播 + 上一张 / 下一张 -->
                            <Grid x:Name="BackgroundMultiRow" Margin="0,14,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="多图切换" FontSize="13" Foreground="#374151" VerticalAlignment="Center" />
                                    <TextBlock x:Name="BackgroundIndexText" Text="第 1 / 1 张"
                                               FontSize="12" Foreground="#9CA3AF" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#F3F4F6" CornerRadius="{DynamicResource Radius8}" Padding="2"
                                            Margin="0,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="BgModeManual" Tag="bgmode:manual" CornerRadius="{DynamicResource Radius6}"
                                                    Cursor="Hand" Background="White" Padding="12,0" Height="28"
                                                    MouseLeftButtonDown="SegTab_Click">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="Black" />
                                                </Border.Effect>
                                                <TextBlock Text="手动切换" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="BgModeAuto" Tag="bgmode:auto" CornerRadius="{DynamicResource Radius6}"
                                                    Cursor="Hand" Background="Transparent" Padding="12,0" Height="28"
                                                    MouseLeftButtonDown="SegTab_Click">
                                                <TextBlock Text="自动轮播" FontSize="12" Foreground="#6B7280"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="PrevBackgroundBtn" Style="{StaticResource GrayBtnStyle}" Height="32" Padding="12,0"
                                            Click="PrevBackground_Click" ToolTip="上一张">
                                        <TextBlock Text="上一张" FontSize="12" VerticalAlignment="Center" />
                                    </Button>
                                    <Button x:Name="NextBackgroundBtn" Style="{StaticResource GrayBtnStyle}" Height="32" Padding="12,0"
                                            Margin="8,0,0,0" Click="NextBackground_Click" ToolTip="下一张">
                                        <TextBlock Text="下一张" FontSize="12" VerticalAlignment="Center" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- 背景不透明度 -->
                            <Grid x:Name="BackgroundOpacityRow" Margin="0,14,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="背景不透明度" FontSize="13" Foreground="#374151" />
                                    <TextBlock x:Name="OpacityValueText" Text="100%" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                                </StackPanel>
                                <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="0" Maximum="100"
                                        SmallChange="1" LargeChange="10" Value="100" Width="220"
                                        Style="{StaticResource SliderStyle}" VerticalAlignment="Center"
                                        ValueChanged="OpacitySlider_ValueChanged" />
                            </Grid>

                            <!-- 背景模糊 -->
                            <Grid x:Name="BackgroundBlurRow" Margin="0,14,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="背景模糊" FontSize="13" Foreground="#374151" />
                                    <TextBlock x:Name="BlurValueText" Text="0（不模糊）" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                                </StackPanel>
                                <Slider x:Name="BlurSlider" Grid.Column="1" Minimum="0" Maximum="30"
                                        SmallChange="1" LargeChange="5" Value="0" Width="220"
                                        Style="{StaticResource SliderStyle}" VerticalAlignment="Center"
                                        ValueChanged="BlurSlider_ValueChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== 2. 布局 ==================== -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius12}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Data="{StaticResource IconLayout}" Width="20" Height="20" Stretch="Uniform"
                              Stroke="#8B5CF6" StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Text="布局" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#111827" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 侧边栏宽度 -->
                    <Border BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="侧边栏宽度" FontSize="13" Foreground="#374151" />
                                <TextBlock Text="左侧导航栏的宽度"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="{DynamicResource Radius8}" Padding="2"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="SidebarNarrow" Tag="sidebar:narrow" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="Transparent"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <TextBlock Text="窄" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="SidebarDefault" Tag="sidebar:default" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="White"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="Black" />
                                        </Border.Effect>
                                        <TextBlock Text="标准" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="SidebarWide" Tag="sidebar:wide" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="Transparent"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <TextBlock Text="宽" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 标题栏高度 -->
                    <Border BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="标题栏高度" FontSize="13" Foreground="#374151" />
                                <TextBlock Text="顶部标题栏的厚度"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="{DynamicResource Radius8}" Padding="2"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="TitlebarCompact" Tag="titlebar:compact" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="Transparent"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <TextBlock Text="紧凑" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="TitlebarDefault" Tag="titlebar:default" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="White"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="Black" />
                                        </Border.Effect>
                                        <TextBlock Text="标准" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="TitlebarLarge" Tag="titlebar:large" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="Transparent"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <TextBlock Text="宽松" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 页面切换动画 -->
                    <Border Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="页面切换动画" FontSize="13" Foreground="#374151" />
                                <TextBlock Text="切换页面时的淡入上移动画"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border x:Name="TogglePageAnimation" Grid.Column="1" Width="42" Height="24"
                                    CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource AccentBrush}" Cursor="Hand"
                                    MouseLeftButtonDown="TogglePageAnimation_Click" VerticalAlignment="Center">
                                <Ellipse Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="TransPageAnimation" X="20" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== 3. 信息显示 ==================== -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius12}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Data="{StaticResource IconInfo}" Width="20" Height="20" Stretch="Uniform"
                              Stroke="#22C55E" StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Text="信息显示" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#111827" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="侧边栏显示版本号" FontSize="13" Foreground="#374151" />
                                <TextBlock Text="导航底部显示当前版本"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border x:Name="ToggleSidebarVersion" Grid.Column="1" Width="42" Height="24"
                                    CornerRadius="{DynamicResource RadiusPill}" Background="{DynamicResource AccentBrush}" Cursor="Hand"
                                    MouseLeftButtonDown="ToggleSidebarVersion_Click" VerticalAlignment="Center">
                                <Ellipse Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="TransSidebarVersion" X="20" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== 4. 下载 ==================== -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius12}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Data="{StaticResource IconDownload}" Width="20" Height="20" Stretch="Uniform"
                              Stroke="#F97316" StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Text="下载" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#111827" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <Border Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="下载页每页数量" FontSize="13" Foreground="#374151" />
                                <TextBlock Text="在线搜索列表每页显示条数"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#F3F4F6" CornerRadius="{DynamicResource Radius8}" Padding="2"
                                    VerticalAlignment="Center" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="PageSize10" Tag="pagesize:10" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="Transparent"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <TextBlock Text="10 条" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="PageSize20" Tag="pagesize:20" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="White"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="Black" />
                                        </Border.Effect>
                                        <TextBlock Text="20 条" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="PageSize40" Tag="pagesize:40" CornerRadius="{DynamicResource Radius6}" Cursor="Hand" Background="Transparent"
                                            Padding="14,0" Height="30" MouseLeftButtonDown="SegTab_Click">
                                        <TextBlock Text="40 条" FontSize="12" Foreground="#6B7280"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== 5. 行为 ==================== -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius12}" Padding="20" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Path Data="{StaticResource IconMove}" Width="20" Height="20" Stretch="Uniform"
                              Stroke="#06B6D4" StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Text="行为" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#111827" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 下载完成系统通知 -->
                    <Border BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="下载完成系统通知" FontSize="13" Foreground="#374151" />
                                <TextBlock Text="下载完成后弹出系统通知提醒"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border x:Name="ToggleDownloadNotify" Grid.Column="1" Width="42" Height="24"
                                    CornerRadius="{DynamicResource RadiusPill}" Background="#D1D5DB" Cursor="Hand"
                                    MouseLeftButtonDown="ToggleDownloadNotify_Click" VerticalAlignment="Center">
                                <Ellipse Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="TransDownloadNotify" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 启动游戏后自动最小化 -->
                    <Border BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="启动游戏后自动最小化" FontSize="13" Foreground="#374151" />
                                <TextBlock Text="游戏窗口出现后最小化启动器"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border x:Name="ToggleMinimizeOnLaunch" Grid.Column="1" Width="42" Height="24"
                                    CornerRadius="{DynamicResource RadiusPill}" Background="#D1D5DB" Cursor="Hand"
                                    MouseLeftButtonDown="ToggleMinimizeOnLaunch_Click" VerticalAlignment="Center">
                                <Ellipse Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="TransMinimizeOnLaunch" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 关闭时最小化到托盘 -->
                    <Border Padding="0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Text="关闭时最小化到托盘" FontSize="13" Foreground="#374151" />
                                <TextBlock Text="点击关闭按钮时隐藏到系统托盘，而非退出"
                                           FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border x:Name="ToggleMinimizeToTray" Grid.Column="1" Width="42" Height="24"
                                    CornerRadius="{DynamicResource RadiusPill}" Background="#D1D5DB" Cursor="Hand"
                                    MouseLeftButtonDown="ToggleMinimizeToTray_Click" VerticalAlignment="Center">
                                <Ellipse Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="TransMinimizeToTray" X="0" />
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ==================== 操作按钮 ==================== -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Style="{StaticResource GrayBtnStyle}" Height="40" Padding="24,0" Click="ResetDefaults_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconRotateCcw}" Width="16" Height="16" Stretch="Uniform"
                              Stroke="#374151" StrokeThickness="2" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                        <TextBlock Text="恢复默认" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="14" Height="14" Fill="#22C55E" VerticalAlignment="Center" />
                    <TextBlock Text="所有改动自动保存并即时生效" FontSize="12" Foreground="#9CA3AF"
                               Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <!-- 说明 -->
            <TextBlock Text="所有设置即时生效，自动保存；下次启动时仍会保留当前配置。"
                       FontSize="12" Foreground="#9CA3AF" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
