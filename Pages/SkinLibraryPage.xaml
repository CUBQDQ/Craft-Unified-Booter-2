<UserControl x:Class="CraftUnifiedBooter.Pages.SkinLibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CraftUnifiedBooter.Pages">
    <UserControl.Resources>
        <!-- ===== lucide 描边图标 ===== -->
        <Geometry x:Key="IconBack">M19 12H5 M12 19L5 12L12 5</Geometry>
        <Geometry x:Key="IconPlus">M12 6.5V17.5 M6.5 12H17.5</Geometry>
        <Geometry x:Key="IconTrash">M3 6H21 M19 6V20A2 2 0 0 1 17 22H7A2 2 0 0 1 5 20V6 M8 6V4A2 2 0 0 1 10 2H14A2 2 0 0 1 16 4V6 M10 11V17 M14 11V17</Geometry>
        <Geometry x:Key="IconSync">M21 12A9 9 0 1 1 18.4 5.6 M21 3V9H15</Geometry>
        <Geometry x:Key="IconShirt">M16 3L20 5L18.5 10L17 9V21H7V9L5.5 10L4 5L8 3L12 6Z</Geometry>
        <Geometry x:Key="IconSparkles">M12 3L13.6 8.4L19 10L13.6 11.6L12 17L10.4 11.6L5 10L10.4 8.4Z M19 15L19.7 17.3L22 18L19.7 18.7L19 21L18.3 18.7L16 18L18.3 17.3Z M5 15L5.6 16.9L7.5 17.5L5.6 18.1L5 20L4.4 18.1L2.5 17.5L4.4 16.9Z</Geometry>
        <Geometry x:Key="IconWings">M12 3L14 8L20 7L16 12L21 15L15 16L12 21L9 16L3 15L8 12L4 7L10 8Z</Geometry>
        <Geometry x:Key="IconCheck">M20 6L9 17L4 12</Geometry>

        <!-- ===== 卡片 ===== -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E5E7EB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect" Value="{StaticResource ShadowSoft}" />
        </Style>

        <!-- ===== 灰色小按钮 ===== -->
        <Style x:Key="GrayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="Foreground" Value="#4B5563" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius7}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 蓝色实心按钮 ===== -->
        <Style x:Key="BlueButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius7}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 图标按钮 ===== -->
        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius6}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEF2F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 3D 皮肤动作切换小按钮（默认 / 走动 / 跑动，类似左上角退出按钮） ===== -->
        <Style x:Key="AnimButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#374151" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="{DynamicResource Radius10}"
                                Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentLightBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource PageBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== 顶部：左上角退出 + 标题 ===================== -->
        <Grid Grid.Row="0" Margin="20,0,20,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Exit_Click" Cursor="Hand" ToolTip="返回主页">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius10}" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconBack}" Width="16" Height="16" Stretch="Uniform"
                                          Stroke="#374151" StrokeThickness="2" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                    <TextBlock Text="退出" FontSize="13" FontWeight="Medium" Foreground="#374151"
                                               Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock Text="皮肤库" FontSize="18" FontWeight="Bold" Foreground="#111827"
                           Margin="16,0,0,0" VerticalAlignment="Center" />
                <Border Background="#EEF2FF" CornerRadius="{DynamicResource Radius6}" Padding="9,3" Margin="10,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="AccountPillText" Text="未选择账户" FontSize="11" Foreground="#4F46E5" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- ===================== 主体：皮肤 / 3D 预览 / 披风 ===================== -->
        <Grid Grid.Row="1" Margin="20,0,20,12">
            <!-- 卡片高度完全跟随窗口自适应：三列一起拉长/缩小，不留空白 -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="248" />
            </Grid.ColumnDefinitions>

            <!-- ===== 左：皮肤 ===== -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 标题栏 + 添加（仅"个人"分类显示添加按钮） -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconShirt}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="#0EA5E9" StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                            <TextBlock Text="皮肤" FontSize="14" FontWeight="SemiBold" Foreground="#374151"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="AddSkinBtn" Grid.Column="1" Style="{StaticResource GrayButtonStyle}" Height="30" Padding="10,0"
                                Click="AddSkin_Click" ToolTip="从本地添加皮肤">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlus}" Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="添加" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 分类：经典（官方默认）/ 个人（正版账号 + 自己添加） -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <Border x:Name="ClassicTab" Background="{DynamicResource AccentSoftBrush}" CornerRadius="{DynamicResource Radius8}" Padding="14,6" Cursor="Hand"
                              MouseLeftButtonDown="SkinTab_Click" Tag="classic">
                            <TextBlock x:Name="ClassicTabText" Text="经典" FontSize="12" FontWeight="Medium"
                                       Foreground="{DynamicResource AccentDarkBrush}" />
                        </Border>
                        <Border x:Name="PersonalTab" Background="#F3F4F6" CornerRadius="{DynamicResource Radius8}" Padding="14,6" Cursor="Hand"
                                MouseLeftButtonDown="SkinTab_Click" Tag="personal" Margin="8,0,0,0">
                            <TextBlock x:Name="PersonalTabText" Text="个人" FontSize="12" FontWeight="Medium"
                                       Foreground="#4B5563" />
                        </Border>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Margin="0,12,0,0">
                        <StackPanel x:Name="SkinListPanel" />
                    </ScrollViewer>

                    <TextBlock Grid.Row="3" x:Name="SkinHintText" FontSize="11" Foreground="#9CA3AF"
                               TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="选择皮肤后自动同步到微软账户。" />
                </Grid>
            </Border>

            <!-- ===== 中：3D 预览 ===== -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="12"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Border Background="#F3F4F6" CornerRadius="{DynamicResource Radius10}" ClipToBounds="True">
                        <Grid>
                            <Grid x:Name="PreviewHost" ClipToBounds="True"
                                  MouseLeftButtonDown="Preview_MouseLeftButtonDown"
                                  MouseLeftButtonUp="Preview_MouseLeftButtonUp"
                                  MouseMove="Preview_MouseMove"
                                  MouseWheel="Preview_MouseWheel"
                                  MouseRightButtonDown="Preview_MouseRightButtonDown"
                                  Background="Transparent">
                                <Viewport3D x:Name="PreviewViewport" ClipToBounds="True"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           RenderOptions.EdgeMode="Aliased">
                                    <Viewport3D.Camera>
                                        <PerspectiveCamera x:Name="PreviewCamera" FieldOfView="45"
                                                           Position="0,0,82" LookDirection="0,0,-82"
                                                           UpDirection="0,1,0" />
                                    </Viewport3D.Camera>
                                    <ModelVisual3D x:Name="PreviewModel" />
                                </Viewport3D>

                                <TextBlock x:Name="PreviewEmptyText" Text="选择皮肤后在此预览"
                                           FontSize="13" Foreground="#9CA3AF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <Border Background="#CC111827" CornerRadius="{DynamicResource Radius6}" Padding="12,5">
                                        <TextBlock x:Name="PreviewHintText" Text="左键左右拖拽旋转 · 滚轮缩放 · 右键重置"
                                                   FontSize="11" Foreground="White" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- 左上角：动作切换（默认 / 走动 / 跑动） -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                        VerticalAlignment="Top" Margin="8">
                                <Button Style="{StaticResource AnimButtonStyle}" Click="AnimDefault_Click" Content="默认" ToolTip="静止站立" />
                                <Button Style="{StaticResource AnimButtonStyle}" Click="AnimWalk_Click" Content="走动" ToolTip="播放走路动作" Margin="6,0,0,0" />
                                <Button Style="{StaticResource AnimButtonStyle}" Click="AnimRun_Click" Content="跑动" ToolTip="播放跑步动作" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ===== 右：披风 ===== -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14"
                    VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconWings}" Width="16" Height="16" Stretch="Uniform"
                                  Stroke="#7C3AED" StrokeThickness="2" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                            <TextBlock Text="披风" FontSize="14" FontWeight="SemiBold" Foreground="#374151"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource GrayButtonStyle}" Height="30" Padding="10,0"
                                Click="AddCape_Click" ToolTip="从本地添加披风">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlus}" Width="14" Height="14" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="添加" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,12,0,0">
                        <StackPanel x:Name="CapeListPanel" />
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" x:Name="CapeHintText" FontSize="11" Foreground="#9CA3AF"
                               TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="登录微软账户后会自动同步正版披风。" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>