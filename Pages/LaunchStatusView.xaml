<UserControl x:Class="CraftUnifiedBooter.Pages.LaunchStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- 图标 -->
        <Geometry x:Key="IconLoader">M21 12A9 9 0 1 1 12 3</Geometry>
        <Geometry x:Key="IconCheckCircle">M2 12A10 10 0 1 1 22 12A10 10 0 1 1 2 12Z M9 12L11 14L15 10</Geometry>
        <Geometry x:Key="IconXCircle">M2 12A10 10 0 1 1 22 12A10 10 0 1 1 2 12Z M15 9L9 15 M9 9L15 15</Geometry>
        <Geometry x:Key="IconCpu">M4 4H20A2 2 0 0 1 22 6V18A2 2 0 0 1 20 20H4A2 2 0 0 1 2 18V6A2 2 0 0 1 4 4Z M9 9H15V15H9Z</Geometry>
        <Geometry x:Key="IconClose">M6 6L18 18 M18 6L6 18</Geometry>

        <!-- 颜色 -->
        <SolidColorBrush x:Key="TextDefault"  Color="#111827" />
        <SolidColorBrush x:Key="TextGreen"    Color="#15803D" />
        <SolidColorBrush x:Key="TextRed"      Color="#DC2626" />
        <SolidColorBrush x:Key="IconBlue"     Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="IconGreen"    Color="#22C55E" />
        <SolidColorBrush x:Key="IconRed"      Color="#EF4444" />
        <SolidColorBrush x:Key="BarBlue"      Color="{DynamicResource AccentColor}" />
        <SolidColorBrush x:Key="BarSuccess"   Color="#22C55E" />
        <SolidColorBrush x:Key="BarError"     Color="#EF4444" />

        <Style x:Key="CollapseBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius6}" Padding="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6" />
                                <Setter Property="Foreground" Value="#374151" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="StatusPanel" Visibility="Collapsed"
            Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
            CornerRadius="{DynamicResource Radius14}" Padding="16" Margin="0,0,0,12" MaxWidth="440">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="2" Opacity="0.18" />
        </Border.Effect>
        <StackPanel>
            <!-- 标题栏 -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="{DynamicResource Radius8}" Background="{DynamicResource AccentSoftBrush}"
                            VerticalAlignment="Center">
                        <StackPanel x:Name="StageStackPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path x:Name="StageIcon" Width="20" Height="20" Stretch="Uniform"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="StageText" Text="准备启动…" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#111827" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="AccountText" Text="账户: -" FontSize="11" Foreground="#6B7280" />
                            <TextBlock Text="  ·  " FontSize="11" Foreground="#D1D5DB" />
                            <TextBlock x:Name="VersionText" Text="版本: -" FontSize="11" Foreground="#6B7280" />
                        </StackPanel>
                    </StackPanel>
                    <!-- 进度百分比（右上角，跟随主色） -->
                    <TextBlock x:Name="StagePercentText" Text="0%" FontSize="12" FontWeight="SemiBold"
                              Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right"
                              VerticalAlignment="Center" Margin="0,0,36,0" />
                </StackPanel>
                <Button Style="{StaticResource CollapseBtnStyle}" HorizontalAlignment="Right"
                        Click="CollapseButton_Click" ToolTip="收起">
                    <Path Data="{StaticResource IconClose}" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2" StrokeStartLineCap="Round" />
                </Button>
            </Grid>

            <!-- 进度条 -->
            <Border Height="6" Background="#F3F4F6" CornerRadius="{DynamicResource Radius3}" Margin="0,12,0,0">
                <Border x:Name="ProgressBorder" Height="6" Background="{DynamicResource AccentBrush}" CornerRadius="{DynamicResource Radius3}"
                        HorizontalAlignment="Left" Width="0" />
            </Border>

            <!-- 错误提示 -->
            <Border x:Name="ErrorBox" Visibility="Collapsed" Background="#FEF2F2" BorderBrush="#FECACA"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius8}" Padding="12" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="启动失败" FontSize="13" FontWeight="SemiBold" Foreground="#DC2626" />
                    <TextBlock x:Name="ErrorText" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 日志区 -->
            <Border Background="{DynamicResource CardBackground}" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius8}" Margin="0,8,0,0" Padding="8">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Hidden" MaxHeight="160">
                    <TextBlock x:Name="LogBox" FontFamily="Consolas" FontSize="11"
                               Foreground="#374151" TextWrapping="NoWrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
